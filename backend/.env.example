# Server
PORT=5000
NODE_ENV=production

# Database (required on Heroku - set DATABASE_URL in Heroku config)
# Neon: postgresql://user:pass@host/db?sslmode=require
# Or use Heroku Postgres addon (auto-sets DATABASE_URL)
DATABASE_URL=

# Local dev only: set to true/1 to use SQLite and avoid "fetch failed" when Neon is unreachable
# USE_SQLITE=true

# JWT (required - use a strong secret in production)
JWT_SECRET=your_jwt_secret_min_32_chars

# Optional: Twilio SMS
TWILIO_ACCOUNT_SID=
TWILIO_AUTH_TOKEN=
TWILIO_VERIFY_SERVICE_SID=

# Optional: Mobile Money
# MTN_MOMO_* / AIRTEL_MONEY_*
