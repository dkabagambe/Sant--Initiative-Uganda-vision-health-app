# Server
PORT=5000
NODE_ENV=production

# Database: use same Neon URL locally and in Vercel so dev and production share one DB.
# Neon: postgresql://user:pass@host/db?sslmode=require
DATABASE_URL=

# Set false (or omit) to use Neon (same as production). Set true only if Neon is unreachable.
USE_SQLITE=false

# JWT (required - use a strong secret in production)
JWT_SECRET=your_jwt_secret_min_32_chars

# Optional: Twilio SMS
TWILIO_ACCOUNT_SID=
TWILIO_AUTH_TOKEN=
TWILIO_VERIFY_SERVICE_SID=

# Optional: Mobile Money
# MTN_MOMO_* / AIRTEL_MONEY_*

# ── Play Store Demo Login ──────────────────────────────────────────────────────
# Set DEMO_LOGIN_ENABLED=true to allow Google Play reviewer demo accounts.
# Each demo number bypasses SMS and accepts only its fixed OTP.
# These must be set BEFORE running: node scripts/seed-demo-accounts.js
#
# IMPORTANT: The existing developer bypass (+256705686573 / OTP 123456) is
# completely separate and is NOT affected by these settings.
#
DEMO_LOGIN_ENABLED=false
DEMO_CHW_PHONE=+256700000101
DEMO_CHW_OTP=472819
DEMO_OUTLET_PHONE=+256700000102
DEMO_OUTLET_OTP=583920
DEMO_VSLA_PHONE=+256700000103
DEMO_VSLA_OTP=694031

