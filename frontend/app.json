{
  "expo": {
    "name": "Santé Initiative Uganda",
    "slug": "sante-initiative",
    "version": "1.4.6",
    "orientation": "default",
    "icon": "./assets/icon.png",
    "userInterfaceStyle": "light",
    "ios": {
      "supportsTablet": true,
      "bundleIdentifier": "com.sante.initiative"
    },
    "android": {
      "adaptiveIcon": {
        "foregroundImage": "./assets/adaptive-icon.png",
        "backgroundColor": "#ffffff"
      },
      "package": "com.sante.initiative",
      "versionCode": 68
    },
    "web": {
      "favicon": "./assets/favicon.png"
    },
    "extra": {
      "eas": {
        "projectId": "e54a32b7-8b48-4cfd-8f85-0043c56373b9"
      }
    },
    "plugins": [
      "expo-sharing",
      [
        "expo-status-bar",
        {
          "androidStatusBar": {
            "translucent": true,
            "backgroundColor": "#00000000",
            "hidden": false
          }
        }
      ],
      "expo-font",
      "expo-sqlite",
      "expo-system-ui",
      [
        "expo-build-properties",
        {
          "android": {
            "minifyEnabled": true,
            "enableProguardInReleaseBuilds": true,
            "enableShrinkResourcesInReleaseBuilds": true,
            "enablePngCrunchInReleaseBuilds": true,
            "extraProguardRules": "-keep class com.sante.initiative.** { *; }\n-keep class expo.modules.** { *; }\n-keep class com.facebook.react.** { *; }\n-keep class com.google.firebase.** { *; }\n-keep class com.swmansion.reanimated.** { *; }\n-keep class com.facebook.react.turbomodule.** { *; }",
            "packagingOptions": {
              "jniLibs": {
                "useLegacyPackaging": false
              }
            }
          }
        }
      ],
      "expo-asset"
    ]
  }
}
