# API URL override (optional — baked into the binary at build time)
# If not set: localhost in dev, Render in production build

# Physical device testing — use your machine's IP:
# EXPO_PUBLIC_API_URL=http://192.168.1.5:5000/api

# Emulator/simulator — localhost works:
# EXPO_PUBLIC_API_URL=http://localhost:5000/api

# Production Render backend:
# EXPO_PUBLIC_API_URL=https://sante-initiative-uganda-app.onrender.com/api
