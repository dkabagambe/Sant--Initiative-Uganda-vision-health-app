# API URL override (optional)
# If not set: localhost in dev, Vercel in production build

# Physical device testing — use your machine's IP so the phone can reach the backend:
# EXPO_PUBLIC_API_URL=http://192.168.1.5:5000/api

# Emulator/simulator — localhost works:
# EXPO_PUBLIC_API_URL=http://localhost:5000/api

# Force production Vercel API (e.g. when testing prod backend in dev):
# EXPO_PUBLIC_API_URL=https://backend-tau-sepia-43.vercel.app/api
